{
  "manifest_version": 3,
  "name": "micro:bit Slide Remote",
  "version": "1.0",
  "description": "micro:bit (Web Bluetooth) のハブページから Google Slides などのタブへキー操作を転送する",
  "permissions": ["tabs"],
  "action": { "default_title": "テスト: Google Slides に『次へ』を送る" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["slides.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
      "js": ["hub.js"],
      "run_at": "document_idle"
    }
  ]
}
